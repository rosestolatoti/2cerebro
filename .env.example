# ============================================================
# 2 CEREBRO — Variaveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env real no git
# ============================================================

# --- Ollama (LLM local) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Modelo leve para classificacao rapida (opcional):
# OLLAMA_MODEL_FAST=qwen2.5:3b

# --- Groq API (gratis) ---
# Crie conta em https://console.groq.com
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# --- Google Gemini API (gratis) ---
# Crie conta em https://ai.google.dev
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash

# --- Seguranca ---
# Token de acesso para a API (deixe vazio para desativar em dev)
API_TOKEN=

# --- Diretorios ---
FOTOS_DIR=fotos
NOTAS_DIR=obsidian_notas
LOGS_DIR=logs
CHROMA_DIR=chroma_data

# --- Performance ---
EMBEDDING_BATCH_SIZE=32
OLLAMA_NUM_THREAD=6

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
